# HISWA-RECRON Career Discovery Platform Environment Variables Template

# App Configuration
VITE_APP_TITLE="Jong RECRON — Ontdek de Recreatiebranche"
VITE_APP_DEFAULT_MODE="stan"
VITE_APP_DEFAULT_LOCALE="nl"
VITE_APP_FALLBACK_LOCALE="en"

# Timer Settings (in seconds)
VITE_APP_STAN_TIMER_SECONDS=120
VITE_APP_SCHOOL_TIMER_SECONDS=180
VITE_APP_IDLE_TIMEOUT_SECONDS=45

# API & Backend Endpoints
VITE_APP_API_URL="/api"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-side (for Vercel Serverless Functions)
# Set these in Vercel Dashboard, NOT in vite env files
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
