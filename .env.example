# HISWA-RECRON Career Discovery Platform Environment Variables Template

# Application Configuration
VITE_APP_TITLE="HISWA-RECRON Career Discovery Game"
VITE_APP_DEFAULT_MODE="stan"
VITE_APP_DEFAULT_LOCALE="nl"
VITE_APP_FALLBACK_LOCALE="en"

# Timer Settings (in seconds)
VITE_APP_STAN_TIMER_SECONDS=120
VITE_APP_SCHOOL_TIMER_SECONDS=180
VITE_APP_IDLE_TIMEOUT_SECONDS=45

# API & Backend Endpoints
VITE_APP_API_URL="/api"

# Vercel KV / Analytics Counter (Set when deploying on Vercel)
KV_REST_API_URL="https://your-kv-db.vercel-storage.com"
KV_REST_API_TOKEN="your_kv_rest_api_token"
